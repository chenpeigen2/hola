          <BeanShellListener guiclass="TestBeanGUI" testclass="BeanShellListener" testname="BeanShell 监听器" enabled="true">
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="script">import java.io.FileWriter; 
import java.io.IOException; 
String returnData = prev.getResponseDataAsString(); // 获取请求响应数据
log.info(returnData); 
String fileName = &quot;../../jmx/data1.txt&quot;; 
FileWriter fw = new FileWriter(fileName, true);
fw.write(returnData); 
fw.write(&quot;\r\n&quot;);
fw.close();
</stringProp>
          </BeanShellListener>
