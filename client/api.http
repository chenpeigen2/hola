### filter find for api
POST /_find HTTP/1.1
Accept: application/json
Content-Length: 37
Content-Type: application/json
Host: localhost:3001


{
  "selector": {
    "$or": [
      {
        "data.countryid": {
          "$gt": -1
        }
      },
      {
        "message": "success"
      }
    ],
    "data.country": "China"
  }
}